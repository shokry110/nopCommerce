# Copy this file to .env and adjust secrets before running docker-compose
ASPNETCORE_ENVIRONMENT=Production
NOP_SQL_SA_PASSWORD=ChangeThisPassword123!
NOP_DB_CONNECTION_STRING=Server=sarayetel_sql;Database=sarayetel;User Id=sa;Password=ChangeThisPassword123!;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True;
NOP_DISTRIBUTED_CACHE_TYPE=redis
NOP_REDIS_CONNECTION_STRING=sarayetel_redis:6379,ssl=False,abortConnect=False,allowAdmin=True
NOP_REDIS_INSTANCE_NAME=sarayetel
NOP_PG_USER=sarayetel
NOP_PG_PASSWORD=ChangeThisPassword123!
NOP_PG_DATABASE=sarayetel
NOP_PG_CONNECTION_STRING=Host=sarayetel_postgres;Port=5432;Database=sarayetel;Username=sarayetel;Password=ChangeThisPassword123!;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=50;No Reset On Close=true;SSL Mode=Disable;
